# Wordora — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit real credentials to version control.
#
# In Netlify: configure these in Site Settings → Environment Variables.

# ─── MongoDB Atlas ───────────────────────────────────────────
# Full connection string from MongoDB Atlas "Connect" dialog.
# Include the database name in the URI for serverless connection reuse.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name within the MongoDB cluster
MONGODB_DB_NAME=wordora

# ─── Session Security ────────────────────────────────────────
# Random secret used for signing/validating session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Site Configuration ──────────────────────────────────────
# The canonical production domain (no trailing slash).
# Used for CORS validation and canonical URLs.
# Example: https://wordora.netlify.app
SITE_URL=
